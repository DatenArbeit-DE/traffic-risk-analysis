# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=traffic
POSTGRES_USER=traffic
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_PORT=5432

# --- Airflow ----------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-local-dev-only
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Generate real values with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-local-dev-only

# --- GDPR: pseudonymization ------------------------------------------------
# HMAC-SHA256 key used to derive accident keys and vehicle plate pseudonyms.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Losing this value makes existing pseudonyms unlinkable (by design).
# Leaking it enables re-identification: store it in a secret manager in production.
PSEUDONYMIZATION_PEPPER=change-me-local-dev-only-pseudonymization-pepper

# --- Ingestion --------------------------------------------------------------
# fixture     -> use the committed, schema-accurate offline sample (default)
# unfallatlas -> download the release URLs below (see README, "Data source")
EXTRACT_SOURCE=fixture
# Comma-separated release URLs (CSV, CSV.GZ or ZIP). The Unfallatlas publishes
# per-year CSV releases through the statistical offices' open-data portals
# (GovData / statistikportal) without a stable download API, so the URLs are
# configuration rather than hardcoded. Leave empty when EXTRACT_SOURCE=fixture.
UNFALLATLAS_URLS=

# --- Retention (GDPR storage limitation) ------------------------------------
RAW_RETENTION_DAYS=90
CLEAN_RETENTION_YEARS=10

# --- Analytics --------------------------------------------------------------
ANALYSIS_WINDOW_YEARS=
MIN_SEGMENT_ACCIDENTS=20
TOP_SEGMENTS_HEATMAP=12
